# ═══════════════════════════════════════════════════════════════════════
# FERREMAT BACKEND — VARIABLES DE ENTORNO
# ────────────────────────────────────────────────────────────────────────
# 1) Copia este archivo como .env  (cp .env.example .env)
# 2) Rellena los valores reales.
# 3) En PRODUCCIÓN (Render) pon estos MISMOS valores como variables de
#    entorno del Web Service en el dashboard de Render (NO subas .env).
# ═══════════════════════════════════════════════════════════════════════

# === Base de datos (Supabase / PostgreSQL) ===============================
# Usa el "Connection pooling" (pooler) de Supabase para la conexión normal
# de la app (Prisma Client). El pooler usa el puerto 6543 y requiere
# ?pgbouncer=true y connection_limit.
# Formato:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Lo encuentras en: Supabase Dashboard → Project Settings → Database →
# "Connection string" → "Prisma" / "Transaction pooler".
DATABASE_URL="postgresql://postgres.<ref>:<TU_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión DIRECTA a la base de datos (puerto 5432). Prisma la usa SOLO
# para las migraciones (npx prisma migrate deploy), porque el pooler de
# pgbouncer no soporta ejecutar migraciones.
#
# OPCIÓN A (lo que Supabase muestra por defecto, puede no funcionar desde ciertas redes):
#   postgresql://postgres:<TU_PASSWORD>@db.<ref>.supabase.co:5432/postgres
#
# OPCIÓN B (funciona desde cualquier red — usa el pooler host en puerto 5432):
#   postgresql://postgres.<ref>:<TU_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Si la opción A te da error P1001, usa la opción B.
# Lo encuentras en: Supabase Dashboard → Project Settings → Database →
# "Connection string" → "Direct connection" / "Session pooler".
DIRECT_URL="postgresql://postgres.<ref>:<TU_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# === Servidor ============================================================
PORT=4000

# En producción pon production. Solo afecta logs y comportamiento de Prisma.
NODE_ENV=development

# IMPORTANTE para Render: el sitio público ya NO lo sirve el backend
# (vive en Netlify aparte). Pon SERVE_FRONTEND=false en producción para que
# Express solo sirva la API y el panel /admin, no el frontend estático.
SERVE_FRONTEND=true

# URL pública del backend (usada para armar URLs absolutas de imágenes
# subidas localmente como fallback). En producción debe ser la URL real de
# Render, ej: https://ferremat-backend.onrender.com
BACKEND_URL="http://localhost:4000"

# Origen(es) permitido(s) para CORS, separados por coma.
# - Local: http://localhost:5500 / Live Server :5500.
# - PRODUCCIÓN: el dominio FINAL del frontend en Netlify (NO localhost),
#   ej: https://ferremat.netlify.app
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"

# === Autenticación ======================================================
# Cambia estos secretos por cadenas largas y aleatorias.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"

# Secreto para firmar la cookie de sesión del panel admin
SESSION_SECRET="cambia_este_otro_secreto_tambien"

# === Administrador inicial (usado solo por prisma/seed.js) ==============
ADMIN_USUARIO="ferrematadmin"
ADMIN_PASSWORD="AdminWebFerremat@_2026"

# === Supabase Storage (imágenes) =========================================
# Opcional: si NO se definen SUPABASE_URL y SUPABASE_SERVICE_KEY, el backend
# guarda las imágenes en disco local (backend/src/uploads) como fallback
# (útil en local con `npm run dev`). En Render debes ponerlas para que las
# imágenes persistan en Supabase Storage (el disco de Render es efímero).
# - SUPABASE_URL: Project URL, ej: https://<ref>.supabase.co
# - SUPABASE_SERVICE_KEY: la clave "Secret key" del panel (empieza con
#   sb_secret_...). En proyectos nuevos de Supabase ya NO existe la antigua
#   "service_role" (Settings → API Keys → Secret keys). Tiene permisos de
#   escritura/borrado para Storage. ¡NUNCA uses la publishable key!
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# === Subida de archivos ==================================================
# Tamaño máximo de imagen en bytes (5MB por defecto)
MAX_UPLOAD_SIZE=5242880
